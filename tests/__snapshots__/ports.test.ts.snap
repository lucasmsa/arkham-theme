exports[`snapshots > alacritty 1`] = `
"# Arkham

[colors.primary]
background = '#161526'
foreground = '#dad6da'

[colors.cursor]
text = '#161526'
cursor = '#ff70b1'

[colors.selection]
text = '#f6f3fc'
background = '#6a6793'

[colors.normal]
black = '#23263c'
